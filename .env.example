# Required. Admin login and API token, at least 32 characters.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Public base URL as seen by browsers, without trailing slash.
# Used for all absolute links and the CSRF origin check. Set it in every non-local deployment.
PUBLIC_URL=https://artifacts.example.com

# Optional. Separate origin for the admin UI and API, e.g. a VPN-only hostname.
# Share links then use PUBLIC_URL, and the admin UI / API answer only on this host.
ADMIN_URL=

# Optional. Separate origin for artifact content, so artifacts can use localStorage, IndexedDB etc.
# MUST be a different registrable domain than PUBLIC_URL (e.g. example-usercontent.com),
# never a sibling subdomain. Leave empty to run artifacts in an opaque-origin sandbox (safe default).
CONTENT_URL=

# Set to true only when a reverse proxy you control sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=true

# Where the container port is published on the host.
BIND_ADDR=127.0.0.1
HOST_PORT=8790

SITE_NAME=Artifacts
MAX_UPLOAD_MB=25
MAX_CONTENT_MB=10
SESSION_DAYS=30
